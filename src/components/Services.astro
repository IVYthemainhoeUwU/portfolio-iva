---
const services = [
  {
    id: "01",
    title: "Brand Architecture",
    description: "Designing the foundation of iconic presence. We structure narratives that resonate beyond the surface."
  },
  {
    id: "02",
    title: "Editorial Strategy",
    description: "Curating content with a distinct point of view. High-impact storytelling for modern platforms."
  },
  {
    id: "03",
    title: "Creative Direction",
    description: "Visual leadership that defines your brand's aesthetic and cultural relevance."
  }
];
---
<section id="services" class="section-container">
  <div class="services-layout">
    <div class="services-header reveal">
      <h2 class="vertical-title">Specialties</h2>
      <div class="header-content">
        <p class="signature">The Methodology</p>
        <h3>Curated Marketing <span>Services</span></h3>
      </div>
    </div>
    
    <div class="services-list">
      {services.map(service => (
        <div class="service-item reveal">
          <span class="service-id">{service.id}</span>
          <div class="service-content">
            <h4>{service.title}</h4>
            <p>{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-layout {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    gap: 100px;
  }

  .services-header {
    position: relative;
  }

  .vertical-title {
    position: absolute;
    top: 0;
    left: -60px;
    transform: rotate(-90deg);
    transform-origin: top left;
    font-size: 0.8rem;
    letter-spacing: 0.5em;
    opacity: 0.3;
  }

  .header-content h3 {
    font-size: 3rem;
    line-height: 1.1;
    margin-top: 10px;
  }

  .header-content h3 span {
    display: block;
    color: var(--accent-color);
  }

  .services-list {
    display: flex;
    flex-direction: column;
  }

  .service-item {
    display: flex;
    gap: 40px;
    padding: 60px 0;
    border-bottom: 1px solid rgba(26, 26, 26, 0.1);
    transition: var(--transition-fluid);
  }

  .service-item:hover {
    padding-left: 20px;
    background: rgba(193, 18, 31, 0.02);
  }

  .service-id {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--accent-color);
    margin-top: 5px;
  }

  h4 {
    font-size: 1.8rem;
    text-transform: none;
    letter-spacing: normal;
    margin-bottom: 15px;
  }

  .service-content p {
    font-size: 1rem;
    color: rgba(26, 26, 26, 0.7);
    max-width: 500px;
  }

  @media (max-width: 968px) {
    .services-layout {
      grid-template-columns: 1fr;
      gap: 60px;
    }
    .vertical-title {
      display: none;
    }
  }
</style>
