              <span class="link-label">EXTERNAL PROJECT</span>
              <span class="link-text">Visit Website →</span>
            </div>
          </a>
        `;
      } else {
        visual02Container.innerHTML = `<img id="overlay-img-02" src="${data.image2}" alt="Closing Visual" />`;
      }

      // Page Num
      document.getElementById('overlay-page-num').textContent = `0${parseInt(id) + 1} / 03`;

      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  });

  closeBtn.addEventListener('click', () => {
    overlay.classList.remove('active');
    document.body.style.overflow = 'auto';
  });
</script>
