  const overlay = document.getElementById('magazine-overlay');
  const closeBtn = document.querySelector('.overlay-close-btn');
  const volumes = document.querySelectorAll('.magazine-volume');

  volumes.forEach(volume => {
    volume.addEventListener('click', () => {
      const id = volume.getAttribute('data-id');
      const data = projectsData[id];
      
      // Header Meta
      overlay.classList.remove('volume-2-active');
      if (id === '1') overlay.classList.add('volume-2-active');
      
      document.getElementById('overlay-top-meta').textContent = `${data.volume} — ${data.date}`;
      document.getElementById('overlay-title').innerHTML = data.title.split(': ').join(':<br/>');
      document.getElementById('overlay-subtitle').textContent = data.subline;
      
      // Sidebar
      document.getElementById('overlay-published').textContent = data.date;
      document.getElementById('overlay-focus').textContent = data.focus;
      document.getElementById('overlay-results-metric').textContent = data.sections.outcomes.metric;
      document.getElementById('overlay-results-label').textContent = data.sections.outcomes.label;
      
      const disciplinesContainer = document.getElementById('overlay-disciplines');
      disciplinesContainer.innerHTML = data.disciplines.map(d => `<span>${d}</span>`).join('');

      const formatEditorialText = (text) => {
        if (!text) return '';
        const lines = text.split('\n');
        let html = '';
        let currentType = null; // 'ul', 'ol', or null

        const closeList = () => {
          if (currentType === 'ul') html += '</ul>';
          if (currentType === 'ol') html += '</ol>';
          currentType = null;
        };

        lines.forEach(line => {
          const trimmed = line.trim();
          if (trimmed.startsWith('* ')) {
            if (currentType !== 'ul') {
              closeList();
              html += '<ul>';
              currentType = 'ul';
            }
            html += `<li>${trimmed.substring(2)}</li>`;
          } else if (/^\d+\.\s/.test(trimmed)) {
            if (currentType !== 'ol') {
              closeList();
              html += '<ol>';
              currentType = 'ol';
            }
            const content = trimmed.replace(/^\d+\.\s/, '');
            html += `<li>${content}</li>`;
          } else if (trimmed === '') {
            closeList();
          } else {
            closeList();
            html += `<p>${trimmed}</p>`;
          }
        });
        closeList();
        return html;
      };

      // Introduction
      document.getElementById('overlay-intro-lead').textContent = data.sections.introduction.lead;
      document.getElementById('overlay-intro-body').innerHTML = formatEditorialText(data.sections.introduction.body);
      document.getElementById('overlay-img-01').src = data.image;

      // Insights
      document.getElementById('overlay-insight-quote').textContent = data.sections.insights.quote;
      document.getElementById('overlay-insight-body').innerHTML = formatEditorialText(data.sections.insights.body);

      // Approach
      const approachGrid = document.getElementById('overlay-approach-grid');
      approachGrid.innerHTML = data.sections.approach.map(step => `
        <div class="approach-step">
          <span class="step-num">${step.label}</span>
          <p class="step-text">${step.text}</p>
        </div>
      `).join('');

      // Outcomes
      document.getElementById('overlay-outcome-metric').textContent = data.sections.outcomes.metric;
      document.getElementById('overlay-outcome-label').textContent = data.sections.outcomes.label;
      document.getElementById('overlay-outcome-body').innerHTML = formatEditorialText(data.sections.outcomes.body);

      // Takeaway
      document.getElementById('overlay-takeaway-lead').textContent = data.sections.takeaway.lead;
      document.getElementById('overlay-takeaway-body').innerHTML = formatEditorialText(data.sections.takeaway.body);
      
      const visual02Container = document.getElementById('overlay-visual-02');
      if (data.image2Type === 'embed') {
        visual02Container.innerHTML = `<iframe src="${data.image2}" height="550" width="100%" frameborder="0" allowfullscreen="" title="Embedded post" style="border-radius: 8px; border: 1px solid var(--border-color);"></iframe>`;
      } else if (data.image2Type === 'link') {
        const label = data.image2Label || 'VIEW PROJECT ↗';
        visual02Container.innerHTML = `
          <a href="${data.image2Link}" target="_blank" class="visual-link-wrapper" data-label="${label}">
            <img id="overlay-img-02" src="${data.image2}" alt="Closing Visual" style="${data.image2Blur ? 'filter: grayscale(100%) blur(1.8px);' : 'filter: grayscale(100%);'}" />
